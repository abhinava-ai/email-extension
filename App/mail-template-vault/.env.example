DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_hostinger_mysql_user
DB_PASSWORD=replace_in_hostinger_only
DB_NAME=your_hostinger_mysql_database
DB_CONNECTION_LIMIT=10
APP_ORIGIN=https://templates.abhinava.ai
EXTENSION_ORIGIN=chrome-extension://jfaabllallhbidopnjjoajjgccgedddj
# Sends invitation and password-reset emails. Without these, the Team page gives a link to share instead.
# Set them in Hostinger hPanel, never in a committed file.
MAIL_FROM=
# Microsoft 365 mailboxes (used first when all three are set).
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# Any other mail provider. Port 465 uses SSL and 587 requires STARTTLS.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# Used for both initial administrators only while running npm run db:bootstrap.
# Never commit a real value. Both users must replace it at first login.
ADMIN_TEMP_PASSWORD=

# Optional, used only with npm run db:create-user.
NEW_USER_EMAIL=
NEW_USER_NAME=
NEW_USER_TEMP_PASSWORD=
NEW_USER_ROLE=member
